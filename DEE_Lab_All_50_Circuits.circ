  <circuit name="15_Full_Adder">
    <a name="circuit" val="15_Full_Adder"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="6" loc="(300,40)" name="Text">
      <a name="text" val="15. Full Adder"/>
      <a name="font" val="SansSerif bold 16"/>
    </comp>
    <comp lib="6" loc="(300,66)" name="Text">
      <a name="text" val="Sum = A xor B xor Cin, Cout = AB + Cin(A xor B)"/>
    </comp>
    <comp lib="0" loc="(130,120)" name="Pin">
      <a name="label" val="A"/>
    </comp>
    <comp lib="0" loc="(130,160)" name="Pin">
      <a name="label" val="B"/>
    </comp>
    <comp lib="1" loc="(240,210)" name="XOR Gate">
      <a name="size" val="30"/>
